<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xhq.channels-watch</string>

  <!-- 使用前：把下方所有 /Users/YOUR_USERNAME 替换为你 clone 本仓库的实际路径 -->

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/YOUR_USERNAME/Developer/channels-watch/watch.py</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/Developer/channels-watch</string>

  <!-- 每 300 秒（5 分钟）执行一次 -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Developer/channels-watch/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Developer/channels-watch/logs/launchd.err.log</string>
</dict>
</plist>
